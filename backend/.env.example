PORT=3014

# Regola d'oro: una API key RPC DEDICATA a questo servizio, mai riusata da
# altri backend (MatchPredictor, ecc.) — isola il monitoraggio e l'impatto
# di eventuali problemi per servizio, non genericamente sul nodo.
LUKSO_RPC_URL=https://rpc.chainintegrate.it/rpc/<api-key-dedicata-a-questo-servizio>

IPFS_API_URL=http://127.0.0.1:5001
IPFS_TIMEOUT_MS=15000
MAX_SIGNATURE_AGE_SECONDS=300
DB_PATH=./traceability.db

# Indirizzo della TraceabilityRegistryFactory — usato per verificare che un
# registryAddress ricevuto sia stato davvero deployato da noi, non un
# contratto arbitrario che finge di esserlo.
FACTORY_ADDRESS=0x....

# Dominio della UI ufficiale di mint — unica origin ammessa sulle route
# firmate (pin-json, upload-photo, photos). La lettura pubblica
# (/registry/:address/entries) resta permissiva per l'embed su siti terzi.
ALLOWED_MINT_UI_ORIGIN=https://traceability.chainintegrate.it

# Letture on-chain pubbliche: niente da configurare. La cache è sempre attiva
# e legata al blocco (i dati si ricalcolano solo quando arriva un blocco
# nuovo, quindi sono sempre aggiornati). CHAIN_READ_CACHE_TTL_SECONDS non è
# più usata e si può togliere dal .env.

# Limite di richieste per IP, al minuto (0 = nessun limite).
# Lettura pubblica (esploratore, anche incorporato in siti terzi):
PUBLIC_RATE_LIMIT_PER_MINUTE=120
# Route firmate (librerie, upload, pin): ogni tentativo costa verifiche on-chain.
SIGNED_RATE_LIMIT_PER_MINUTE=60

# Tetto di blocchi per chiamata eth_getLogs — dipende dai limiti del
# provider RPC, non urgente da tarare ora.
MAX_BLOCK_RANGE_PER_CALL=10000

# CHIAVE MADRE per la cifratura dei documenti della libreria (32 byte, base64).
# Generarla UNA volta con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# e custodirne una copia FUORI dal server (password manager + copia stampata):
# se va persa, nessun documento cifrato è più recuperabile. Mai su GitHub.
# Senza questa variabile gli upload di documenti vengono rifiutati.
# Vedi docs/CHIAVE-DOCUMENTI.md.
DOCUMENT_MASTER_KEY=

# Cartella delle copie del database create da scripts/backup-db.js
# (default: backend/backups). Deve essere inclusa nel backup del VPS.
BACKUP_DIR=
