PORT=3010

# Regola d'oro: una API key RPC DEDICATA a questo servizio, mai riusata da
# altri backend (MatchPredictor, ecc.) — isola il monitoraggio e l'impatto
# di eventuali problemi per servizio, non genericamente sul nodo.
LUKSO_RPC_URL=https://rpc.chainintegrate.it/rpc/<api-key-dedicata-a-questo-servizio>

IPFS_API_URL=http://127.0.0.1:5001
IPFS_TIMEOUT_MS=15000
MAX_SIGNATURE_AGE_SECONDS=300
DB_PATH=./traceability.db

# Indirizzo della TraceabilityRegistryFactory — usato per verificare che un
# registryAddress ricevuto sia stato davvero deployato da noi, non un
# contratto arbitrario che finge di esserlo.
FACTORY_ADDRESS=0x....

# Dominio della UI ufficiale di mint — unica origin ammessa sulle route
# firmate (pin-json, upload-photo, photos). La lettura pubblica
# (/registry/:address/entries) resta permissiva per l'embed su siti terzi.
ALLOWED_MINT_UI_ORIGIN=https://traceability.chainintegrate.it

# 0 = cache letture on-chain disattivata (default, va bene per i volumi
# attuali). Impostare un valore >0 (secondi) quando il volume di entry
# cresce e il costo delle chiamate RPC ripetute inizia a farsi sentire.
CHAIN_READ_CACHE_TTL_SECONDS=0

# Tetto di blocchi per chiamata eth_getLogs — dipende dai limiti del
# provider RPC, non urgente da tarare ora.
MAX_BLOCK_RANGE_PER_CALL=10000
