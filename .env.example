# MAI committare il file .env vero (solo questo .env.example) — il
# .gitignore alla radice del repo lo esclude già.

# Chiave privata dell'account che PAGA IL GAS del deploy — non deve
# necessariamente essere la UP ChainIntegrate (chainIntegrateOwner è
# cablato separatamente in scripts/deploy.js). Basta che abbia LYX.
PRIVATE_KEY=

# RPC testnet — pubblico va bene per il deploy iniziale di prova
LUKSO_TESTNET_RPC_URL=https://rpc.testnet.lukso.network

# RPC mainnet — nodo self-hosted ChainIntegrate, chiave dedicata a QUESTO
# scopo (deploy), diversa da quella del backend traceability e da quella
# di MatchPredictor (regola d'oro: una chiave per servizio).
LUKSO_MAINNET_RPC_URL=https://rpc.chainintegrate.it/rpc/<api-key-dedicata-al-deploy>
