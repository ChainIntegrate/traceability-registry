{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chainintegrate.it/schemas/traceability/production-batch.schema.json",
  "title": "TraceabilityRegistry - Batch di Produzione",
  "type": "object",
  "required": ["name", "description", "attributes"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "image": {
      "type": "string",
      "minLength": 1,
      "description": "Opzionale: se assente, la UI usa la libreria foto per ricetta."
    },
    "attributes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["trait_type", "value"],
        "properties": {
          "trait_type": { "type": "string", "minLength": 1 },
          "value": { "type": ["string", "number"] }
        },
        "additionalProperties": false
      },
      "description": "Deve contenere 'Ricetta' e almeno una data riconosciuta (verificato dal validatore JS: le regole 'contiene Ricetta', 'almeno una data tra quelle whitelisted', 'ogni chiave che inizia per Lotto ' non sono esprimibili pulitamente in puro JSON Schema)."
    }
  },
  "additionalProperties": false
}
